{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@cpzero/core": [
        "packages/core/src/index.ts"
      ],
      "@cpzero/codex": [
        "packages/codex/src/index.ts"
      ]
    }
  },
  "include": [
    "packages/core/src/**/*.ts",
    "examples/**/*.ts",
    "tests/**/*.ts",
    "packages/codex/src/**/*.ts"
  ]
}
