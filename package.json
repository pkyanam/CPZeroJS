{
  "name": "cpzerojs",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript apps. Native pixels. Built for Cardputer Zero.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node packages/cli/src/index.mjs dev examples/dashboard/src/main.ts",
    "build": "node packages/cli/src/index.mjs build examples/dashboard/src/main.ts",
    "native": "bash scripts/build-native.sh",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "test:native": "node --test tests/native.test.mjs",
    "dev:catalog": "node packages/cli/src/index.mjs dev examples/catalog/src/main.ts",
    "doctor": "node packages/cli/src/index.mjs doctor",
    "package:device": "bash scripts/package-device.sh",
    "benchmark": "node scripts/benchmark.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  }
}
